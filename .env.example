# Train Race Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=True
APP_NAME="Train Race"

# Database (PostgreSQL for production, SQLite for local development fallback)
DATABASE_URL=sqlite+aiosqlite:///./train_race.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/train_race

# Redis Caching (Optional)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# Railway Data Provider
# Options: "demo" (default realistic simulation), "rapidapi" (RapidAPI Indian Railways)
RAILWAY_API_PROVIDER=demo

# RapidAPI Credentials (Required only if RAILWAY_API_PROVIDER=rapidapi)
RAPIDAPI_KEY=
RAPIDAPI_HOST=irctc1.p.rapidapi.com

# RailRadar Credentials (Optional)
RAILRADAR_API_KEY=

# Refresh Settings
REFRESH_INTERVAL_SECONDS=15

# URLs
BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
